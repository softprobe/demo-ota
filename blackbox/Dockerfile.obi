FROM alpine:3.21

ARG OBI_VERSION=1.0.0
RUN apk add --no-cache ca-certificates curl tar \
    && ARCH="$(uname -m)" \
    && case "$ARCH" in \
         x86_64) OBI_ARCH="amd64" ;; \
         aarch64) OBI_ARCH="arm64" ;; \
         *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;; \
       esac \
    && curl -fLO "https://github.com/open-telemetry/opentelemetry-ebpf-instrumentation/releases/download/v${OBI_VERSION}/obi-v${OBI_VERSION}-linux-${OBI_ARCH}.tar.gz" \
    && curl -fLO "https://github.com/open-telemetry/opentelemetry-ebpf-instrumentation/releases/download/v${OBI_VERSION}/SHA256SUMS" \
    && grep -F "obi-v${OBI_VERSION}-linux-${OBI_ARCH}.tar.gz" SHA256SUMS | sha256sum -c - \
    && tar -xzf "obi-v${OBI_VERSION}-linux-${OBI_ARCH}.tar.gz" \
    && install -m 0755 obi /usr/local/bin/obi \
    && rm -f "obi-v${OBI_VERSION}-linux-${OBI_ARCH}.tar.gz" SHA256SUMS obi

ENTRYPOINT ["/usr/local/bin/obi"]
